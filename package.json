{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate --config=drizzle.config.user.ts && drizzle-kit generate --config=drizzle.config.admin.ts && drizzle-kit generate --config=drizzle.config.product.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.user.ts && drizzle-kit push --config=drizzle.config.admin.ts && drizzle-kit push --config=drizzle.config.product.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.user.ts && drizzle-kit migrate --config=drizzle.config.admin.ts && drizzle-kit migrate --config=drizzle.config.product.ts",
    "db:studio:user": "drizzle-kit studio --config=drizzle.config.user.ts",
    "db:studio:admin": "drizzle-kit studio --config=drizzle.config.admin.ts",
    "db:studio:product": "drizzle-kit studio --config=drizzle.config.product.ts",
    "db:studio": "npm run db:studio:user"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.12",
    "pdf-lib": "^1.17.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-easy-crop": "^5.5.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
